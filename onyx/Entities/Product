{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Product name"
    },
    "collection": {
      "type": "string",
      "description": "Collection name"
    },
    "price": {
      "type": "number",
      "description": "Price in USD"
    },
    "description": {
      "type": "string",
      "description": "Product description"
    },
    "category": {
      "type": "string",
      "enum": [
        "outerwear",
        "tops",
        "bottoms",
        "dresses",
        "accessories"
      ],
      "description": "Product category"
    },
    "sizes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Available sizes"
    },
    "image_url": {
      "type": "string",
      "description": "Primary product image URL"
    },
    "gallery_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional gallery images"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Whether the product is featured"
    }
  },
  "required": [
    "name",
    "price"
  ]
}